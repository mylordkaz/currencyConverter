# ExchangeRate-API (https://www.exchangerate-api.com) — key goes in the URL path
FIAT_API_URL=https://v6.exchangerate-api.com
FIAT_API_KEY=your-exchangerate-api-key

# CoinMarketCap Pro (https://pro.coinmarketcap.com) — key sent via X-CMC_PRO_API_KEY header
CRYPTO_API_URL=https://pro-api.coinmarketcap.com
CRYPTO_API_KEY=your-coinmarketcap-key

# Comma-separated allowed browser origins for CORS
FRONT_URL=http://localhost:5173

PORT=8080
